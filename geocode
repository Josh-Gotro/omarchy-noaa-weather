#!/usr/bin/env bash
# Resolve a free-text location to "lat lon label".
#
#   ./geocode "78701"          -> 30.2713 -97.7426 Austin, TX
#   ./geocode "Austin, TX"     -> 30.2672 -97.7431 Austin, Texas, United States
#   ./geocode "30.27,-97.74"   -> 30.27 -97.74 30.27,-97.74      (no lookup)
#
# Results are cached indefinitely: a ZIP or a city name does not move. Delete
# the cache directory to force a re-resolve.
#
# No API key is required by either service. Nominatim asks for a descriptive
# User-Agent and at most one request per second; the cache means we are far
# under that in practice.
#
# Everything that comes back is remote text. Coordinates must parse as
# coordinates and the label is stripped to one bounded printable line before
# any of it is printed, because the output of this script becomes provider
# arguments and cache content.

set -uo pipefail

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
. "$HERE/lib.sh"

query="${1:-}"
[[ -n $query ]] || { echo "usage: geocode <zip|city|lat,lon>" >&2; exit 2; }

# A literal "lat,lon" needs no service at all.
if [[ $query =~ ^[[:space:]]*(-?[0-9]+(\.[0-9]+)?)[[:space:]]*,[[:space:]]*(-?[0-9]+(\.[0-9]+)?)[[:space:]]*$ ]]; then
  printf '%s %s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[3]}" "$(sanitize_line "$query" 80)"
  exit 0
fi

CACHE_OK=1
cache_init || CACHE_OK=0

# Only lines shaped like "lat lon label" leave this script or its cache.
emit_checked() {
  local line lat lon label
  line=$(sanitize_line "$1" 200)
  read -r lat lon label <<<"$line"
  [[ $lat =~ ^-?[0-9]{1,3}(\.[0-9]+)?$ ]] || return 1
  [[ $lon =~ ^-?[0-9]{1,3}(\.[0-9]+)?$ ]] || return 1
  [[ -n ${label:-} ]] || label="$query"
  printf '%s %s %s\n' "$lat" "$lon" "$label"
}

key=$(printf '%s' "${query,,}" | md5sum | cut -d' ' -f1)
cache="geo-$key"
if (( CACHE_OK )) && cached=$(cache_get_raw "$cache") && emit_checked "$cached"; then
  exit 0
fi

# fetch_json URL HOST: bounded, host-checked, must be valid JSON.
fetch_json() {
  local url="$1" host="$2" body_file code rc
  body_file=$(mktemp "${TMPDIR:-/tmp}/geo-body.XXXXXX") || return 1
  code=$(http_get "$url" "$body_file" "$host")
  rc=$?
  if (( rc != 0 )) || [[ $code != 2* ]]; then rm -f "$body_file"; return 1; fi
  jq -e . "$body_file" >/dev/null 2>&1 || { rm -f "$body_file"; return 1; }
  cat "$body_file"
  rm -f "$body_file"
}

result=""
if [[ $query =~ ^[[:space:]]*[0-9]{5}[[:space:]]*$ ]]; then
  # US ZIP: zippopotam is exact and needs no query-string escaping.
  zip="${query//[[:space:]]/}"
  result=$(fetch_json "https://api.zippopotam.us/us/$zip" api.zippopotam.us | jq -r '
    .places[0] as $p
    | if $p == null then empty
      else "\($p.latitude) \($p.longitude) \($p["place name"]), \($p["state abbreviation"])" end')
else
  # City / place name.
  esc=$(jq -rn --arg q "$query" '$q|@uri')
  result=$(fetch_json "https://nominatim.openstreetmap.org/search?q=$esc&format=json&limit=1" nominatim.openstreetmap.org | jq -r '
    .[0] as $r
    | if $r == null then empty
      else "\($r.lat) \($r.lon) \($r.display_name | split(", ") | if length > 3 then [.[0], .[-3], .[-1]] else . end | join(", "))" end')
fi

if [[ -z $result ]] || ! line=$(emit_checked "$result"); then
  echo "could not resolve: $query" >&2
  exit 3
fi

if (( CACHE_OK )); then printf '%s\n' "$line" | cache_put "$cache"; fi
printf '%s\n' "$line"
