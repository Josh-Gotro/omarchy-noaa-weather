#!/usr/bin/env bash
# NOAA / weather.gov provider.
#
#   providers/noaa <lat> <lon> [alias] [fallback-label]
#
# Prints one normalized "page" object on stdout:
#   { label, text, icon, state, tooltip, rows: [...] }
#
# This is the provider seam: any script that takes these arguments and
# prints this shape fits behind weather-fetch. Nothing NOAA-specific leaks
# past this file. Which providers may run at all is a fixed allowlist in
# weather-fetch, not a setting.
#
# NOAA requires no API key. It does require a User-Agent that identifies the
# caller, and it serves the United States only.
#
# Network policy: every request this script makes, including requests to
# URLs that NOAA's own responses hand back, goes through lib.sh's http_get,
# which refuses anything that is not https to api.weather.gov exactly.

set -uo pipefail

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
. "$HERE/../lib.sh"

lat="${1:?lat required}"; lon="${2:?lon required}"
alias_label="${3:-}"      # user-supplied alias, wins outright
fallback_label="${4:-}"   # geocoder's label, last resort

UNITS="${WEATHER_UNITS:-f}"
DAYS="${WEATHER_DAYS:-5}"

# Coordinates come from the geocoder, which read them out of a remote
# response. They must look like coordinates before they are allowed anywhere
# near a URL.
[[ $lat =~ ^-?[0-9]{1,3}(\.[0-9]+)?$ ]] || exit 2
[[ $lon =~ ^-?[0-9]{1,3}(\.[0-9]+)?$ ]] || exit 2

# NOAA's /points endpoint accepts at most 4 decimal places and answers a 301
# redirect to the rounded form for anything longer. Nominatim returns 7, so
# without this every city-name lookup would bounce off a redirect. Rounding
# here also keeps the cache key stable for coordinates that differ only in
# noise digits. 4 decimals is ~11 m, far finer than a 2.5 km forecast grid.
# LC_ALL=C is load-bearing: printf's %f honours LC_NUMERIC, so under a
# comma-decimal locale (de_DE, fr_FR, pt_BR...) this emits "30,2711" and builds
# https://api.weather.gov/points/30,2711,-97,7437 -- a malformed URL that fails
# for every one of those users and for nobody testing in en_US.
lat=$(LC_ALL=C printf '%.4f' "$lat")
lon=$(LC_ALL=C printf '%.4f' "$lon")

# 0700 and verified: the caches record where this user has been looking,
# which is nobody else's business on a shared machine. If the directory
# cannot be made safe, run without a cache rather than through an unsafe one.
CACHE_OK=1
cache_init || CACHE_OK=0

# fetch_api URL: body on stdout, bounded and host-checked by http_get.
#   exit 22 -> outside NOAA coverage      exit 29 -> rate limited / NOAA down
#   exit 21 -> other HTTP error or non-JSON body
#   exit 6/7/28 -> resolve / connect / timeout
#   exit 60/63/65 -> URL refused / body too large / redirect refused
fetch_api() {
  local url="$1" body_file code rc
  body_file=$(mktemp "${TMPDIR:-/tmp}/noaa-body.XXXXXX") || return 21
  code=$(http_get "$url" "$body_file" api.weather.gov)
  rc=$?
  if (( rc != 0 )); then
    rm -f "$body_file"
    return $rc
  fi
  case "$code" in
    2*)     ;;
    404)    rm -f "$body_file"; return 22 ;;
    429|5*) rm -f "$body_file"; return 29 ;;
    *)      rm -f "$body_file"; return 21 ;;
  esac
  jq -e . "$body_file" >/dev/null 2>&1 || { rm -f "$body_file"; return 21; }
  cat "$body_file"
  rm -f "$body_file"
}

ck_get() { (( CACHE_OK )) && cache_get "$@"; }
ck_put() { if (( CACHE_OK )); then cache_put "$@"; else cat >/dev/null; fi; }

# /points is a stable lat,lon -> grid mapping. NOAA asks that it be cached
# rather than re-fetched on every poll, so it is, for a week.
pkey=$(printf '%s,%s' "$lat" "$lon" | md5sum | cut -d' ' -f1)
pcache="$CACHE_DIR/points-$pkey.json"
points=""
if points=$(ck_get "$pcache" 604800) && jq -e '.properties.forecast' <<<"$points" >/dev/null 2>&1; then
  :
else
  if points=$(fetch_api "https://api.weather.gov/points/$lat,$lon"); then
    printf '%s' "$points" | ck_put "$pcache"
  else
    rc=$?
    # A stale mapping still beats no forecast at all, so only fail outright
    # when there is nothing safe on disk to fall back to.
    points=$(ck_get "$pcache") || exit $rc
  fi
fi

# These URLs arrived inside a NOAA response. They are revalidated by
# http_get before any request goes out, so a tampered or spoofed response
# cannot point the next fetch at another origin; the explicit check here
# just fails faster and clearer.
forecast_url=$(jq -r '.properties.forecast // empty' <<<"$points")
stations_url=$(jq -r '.properties.observationStations // empty' <<<"$points")
[[ -n $forecast_url ]] || exit 22   # no gridpoint here: outside NOAA's coverage
url_allowed "$forecast_url" api.weather.gov || exit 60
[[ -z $stations_url ]] || url_allowed "$stations_url" api.weather.gov || stations_url=""

# NOAA's nearest named place ("Austin, TX") reads far better than a geocoder's
# ("Austin, Travis County, United States"), so it wins unless the user named
# the location themselves. It is remote text, so it is sanitized like all of it.
noaa_label=$(jq -r '[.properties.relativeLocation.properties.city,
                     .properties.relativeLocation.properties.state]
                    | map(select(. != null)) | join(", ")' <<<"$points" 2>/dev/null)
noaa_label=$(sanitize_line "$noaa_label" 80)
label="${alias_label:-${noaa_label:-$fallback_label}}"

# Short-lived forecast cache. NOAA publishes hourly, so re-reading a response
# from the last few minutes costs nothing in freshness -- and it is what keeps
# a burst of polls (editing several locations in a row, each of which triggers
# a refetch of every location) from tripping NOAA's rate limiter.
FORECAST_TTL="${WEATHER_FORECAST_TTL:-300}"
fkey=$(printf '%s' "$forecast_url" | md5sum | cut -d' ' -f1)
fcache="$CACHE_DIR/forecast-$fkey.json"
if ! forecast=$(ck_get "$fcache" "$FORECAST_TTL"); then
  if forecast=$(fetch_api "$forecast_url"); then
    printf '%s' "$forecast" | ck_put "$fcache"
  else
    rc=$?
    # A slightly stale forecast beats an error for a blip -- but only if that
    # stale copy is safe to read and still parses.
    forecast=$(ck_get "$fcache") || exit $rc
  fi
fi

# Current conditions come from the nearest station that is actually reporting;
# the closest one is sometimes stale or missing a temperature.
current='null'
if [[ -n $stations_url ]]; then
  skey=$(printf '%s' "$stations_url" | md5sum | cut -d' ' -f1)
  scache="$CACHE_DIR/stations-$skey.json"
  stations=$(ck_get "$scache") \
    || { stations=$(fetch_api "$stations_url") && printf '%s' "$stations" | ck_put "$scache"; } \
    || stations=""
  ocache="$CACHE_DIR/obs-$skey.json"
  if obs_cached=$(ck_get "$ocache" "$FORECAST_TTL"); then
    current="$obs_cached"
  elif [[ -n $stations ]]; then
    for st in $(jq -r '.features[0:3][].properties.stationIdentifier // empty' <<<"$stations" 2>/dev/null); do
      # The station id lands in a URL path, so it is held to what station ids
      # actually look like. Anything else in the response is skipped.
      [[ $st =~ ^[A-Za-z0-9._-]{1,16}$ ]] || continue
      obs=$(fetch_api "https://api.weather.gov/stations/$st/observations/latest") || continue
      [[ $(jq -r '.properties.temperature.value // "null"' <<<"$obs") != "null" ]] || continue
      current="$obs"
      printf '%s' "$obs" | ck_put "$ocache"
      break
    done
    # Fall back to a stale observation rather than dropping the "Now" row.
    if [[ $current == "null" ]]; then current=$(ck_get "$ocache") || current='null'; fi
  fi
fi

jq -n \
  --argjson forecast "$forecast" \
  --argjson current "$current" \
  --arg label "$label" \
  --arg units "$UNITS" \
  --argjson days "$DAYS" \
  -f "$HERE/../weather.jq"
